<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <%- partial('partials/head') %>
</head>
<body>
  <%- partial('partials/header') %>

  <main class="main-content">
    <div class="container container-wide">
      <h1 class="page-title"><%= page.title %></h1>
      <% var corpus = (site.data && site.data.rephrase && site.data.rephrase.corpus) ? site.data.rephrase.corpus[page.corpus_key] : null; %>
      <% if (!corpus || !corpus.sentences || !corpus.sentences.length) { %>
        <p class="corpus-empty">Corpus data not found. Run <code>node tools/import-rephrase.js</code> and rebuild.</p>
      <% } else { %>
        <p class="corpus-meta">
          <span><%= corpus.files.map(function (f) { return f.file; }).join(', ') %></span>
          &middot;
          <span><%= corpus.sentences.length %> sentences</span>
        </p>
        <div id="corpusApp"></div>
        <script>
          var CORPUS_DATA = <%- JSON.stringify(corpus.sentences).replace(/</g, '\\u003c') %>;
        </script>
      <% } %>
    </div>
  </main>

  <%- partial('partials/footer') %>
  <script src="<%= url_for('/js/corpus.js') %>"></script>
</body>
</html>
