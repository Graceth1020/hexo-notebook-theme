<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <%- partial('partials/head') %>
</head>
<body>
  <%- partial('partials/header') %>

  <main class="main-content">
    <div class="container container-wide">
      <h1 class="page-title"><%= page.title %></h1>
      <% var notes = (site.data && site.data.rephrase && site.data.rephrase.notes) ? site.data.rephrase.notes : []; %>
      <% if (!notes.length) { %>
        <p class="notes-empty">No notes yet. Entries are imported from <code>notes/</code> by <code>tools/import-rephrase.js</code>.</p>
      <% } else { %>
        <div id="notesApp"></div>
        <script>
          var NOTES_DATA = <%- JSON.stringify(notes).replace(/</g, '\\u003c') %>;
        </script>
      <% } %>
    </div>
  </main>

  <%- partial('partials/footer') %>
  <script src="<%= url_for('/js/notes.js') %>"></script>
</body>
</html>
